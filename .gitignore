# ============================================================
# GoM_ComDemo_STM32_HAL  (STM32F103C8 + Keil MDK-ARM)
# 原则：忽略编译中间文件，保留输出目录及其中的固件
# ============================================================

# ------------------------------------------------------------
# 1. Keil 编译中间文件（任意目录，防御性写法）
# ------------------------------------------------------------
*.o
*.d
*.crf
*.dep
*.lnp
*.iex
*.axf
*.map
*.lst
*.build_log.htm
# 注意：*.sct 不在此处全局忽略，避免误伤自定义分散加载文件，
#       只忽略输出目录里由 Keil 自动生成的那一份（见第 2 节）

# ------------------------------------------------------------
# 2. 输出目录 MDK-ARM/GoM_ComDemo_STM32_HAL/
#    显式列出，保证即使改动了上面的全局规则也不会误删
# ------------------------------------------------------------
/MDK-ARM/GoM_ComDemo_STM32_HAL/*.o
/MDK-ARM/GoM_ComDemo_STM32_HAL/*.d
/MDK-ARM/GoM_ComDemo_STM32_HAL/*.crf
/MDK-ARM/GoM_ComDemo_STM32_HAL/*.dep
/MDK-ARM/GoM_ComDemo_STM32_HAL/*.lnp
/MDK-ARM/GoM_ComDemo_STM32_HAL/*.iex
/MDK-ARM/GoM_ComDemo_STM32_HAL/*.axf
/MDK-ARM/GoM_ComDemo_STM32_HAL/*.map
/MDK-ARM/GoM_ComDemo_STM32_HAL/*.sct
# 编译日志与静态调用图报告（.build_log.htm / .htm），体积大且可重新生成
/MDK-ARM/GoM_ComDemo_STM32_HAL/*.htm

# ------------------------------------------------------------
# 3. 需要保留的文件（不写规则也会被跟踪，这里仅作说明）
#    - *.hex / *.bin   : 最终固件，用于烧录和发布
#    - *.uvprojx       : 工程文件
#    - *.s             : 启动文件
#    - RTE/**          : RTE_Components.h 等，编译必需
#    - DebugConfig/**  : 调试器配置
# ------------------------------------------------------------

# ------------------------------------------------------------
# 4. Keil 个人配置与调试器日志（与电脑/用户相关，不应入库）
# ------------------------------------------------------------
*.uvguix.*
*.scvd.log
JLinkLog.txt
JLinkSettings.ini

# 说明：.uvoptx 里存有调试器/下载算法/Flash Download 等目标设置，
#       保留入库，避免队友重新配置；个人窗口布局在 *.uvguix.* 中，已被忽略。

# ------------------------------------------------------------
# 5. 其他工具链产物（预留：日后迁移到 CMake / GCC 时生效）
# ------------------------------------------------------------
build/
Debug/
Release/
Objects/
Listings/
CMakeFiles/
CMakeCache.txt
cmake-build-*/
*.elf
*.srec
*.s19

# ------------------------------------------------------------
# 6. 操作系统 / 编辑器 / 临时文件
# ------------------------------------------------------------
Thumbs.db
desktop.ini
.DS_Store
*.swp
*~
*.bak
.vscode/
.idea/

# ------------------------------------------------------------
# 7. CubeMX 重新生成时产生的备份
# ------------------------------------------------------------
*.ioc.bak
